# ==============================================================================
# Fortress Chat Backend - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Output & Dependencies (Maven / Java)
# ------------------------------------------------------------------------------
target/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven Release & Backup Files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# JVM Crash Logs
hs_err_pid*
replay_pid*

# Code Coverage & Testing
*.exec
.coverage/
.jacoco/

# ------------------------------------------------------------------------------
# Environment, Secrets & Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
*.env
.env
.env.*
!.env.example
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.jks
*.keystore

# Firebase & Google Cloud Service Account Keys
*firebase-service-account*.json
*service-account*.json
*credentials*.json
src/main/resources/*service-account*.json
src/main/resources/firebase-*.json

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# Eclipse
.apt_generated/
.apt_generated_tests/
.classpath
.project
.settings/
.factorypath

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# General Editors & Swap Files
*.swp
*.swo
*~
.*.sw?
*.bak
*.tmp

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Logs & Runtime Files
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# Docker / Local Database Mounts
# ------------------------------------------------------------------------------
.docker/
pgdata/
postgres-data/
kafka-data/
zookeeper-data/
